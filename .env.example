SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_PUBLIC_URL=http://localhost:3000
# Bytes; default 1 MiB. Maximum supported: 10 MiB.
WEBHOOK_MAX_PAYLOAD_SIZE=1048576
# 32 bytes encoded as 64 hexadecimal characters. See README to generate.
WEBHOOK_TOKEN_ENCRYPTION_KEY=
# Enable only behind a proxy that REPLACES x-forwarded-for.
WEBHOOK_TRUST_PROXY=false
